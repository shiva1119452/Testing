<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.repository.UserMapper">

    <insert id="save"
            parameterType="com.example.model.UserDto"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO users (name, email, age)
        VALUES (#{name}, #{email}, #{age})

    </insert>


    <select id="findById"
            parameterType="long"
            resultType="com.example.model.UserDto">

        SELECT
            id,
            name,
            email,
            age
        FROM users
        WHERE id = #{id}

    </select>


    <select id="findAll"
            resultType="com.example.model.UserDto">

        SELECT
            id,
            name,
            email,
            age
        FROM users
        ORDER BY id

    </select>


    <update id="update"
            parameterType="com.example.model.UserDto">

        UPDATE users
        SET
            name = #{name},
            email = #{email},
            age = #{age}
        WHERE id = #{id}

    </update>


    <delete id="deleteById"
            parameterType="long">

        DELETE FROM users
        WHERE id = #{id}

    </delete>

</mapper>